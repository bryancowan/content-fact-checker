# LLM provider: "openai" (default, gpt-6-luna), "cerebras" (qwen-3.8-27b) or
# "openrouter" (any model OpenRouter serves). Only the key for the provider you use
# is required.
OPENAI_API_KEY=your_openai_api_key_here
# CEREBRAS_API_KEY=your_cerebras_api_key_here
# OPENROUTER_API_KEY=your_openrouter_api_key_here
PARALLEL_API_KEY=your_parallel_api_key_here

# Optional overrides. Defaults are set in src/fact_checker/config.py.
# LLM_PROVIDER=openai
# LLM_MODEL_NAME lets you move off a deprecated model without a code change.
# Defaults: gpt-6-luna (openai), qwen-3.8-27b (cerebras), nvidia/nemotron-3.5-super-vl
# (openrouter; use OpenRouter's provider/model slugs, e.g. reflection/beam-1.0-501b-a23b).
# LLM_MODEL_NAME=gpt-6-luna
# LLM_REQUESTS_PER_MIN=300
# LLM_MAX_COMPLETION_TOKENS=16384
# OPENAI_REASONING_EFFORT=high
# CEREBRAS_REASONING_EFFORT=high
# OPENROUTER_REASONING_EFFORT=high
