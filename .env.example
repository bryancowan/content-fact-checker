# LLM provider: "openrouter" (default, particle-ai/particle-1; any model OpenRouter serves),
# "openai" (gpt-6-luna) or "cerebras" (qwen-3.8-27b). Only the key for the provider you use
# is required.
OPENROUTER_API_KEY=your_openrouter_api_key_here
# OPENAI_API_KEY=your_openai_api_key_here
# CEREBRAS_API_KEY=your_cerebras_api_key_here
PARALLEL_API_KEY=your_parallel_api_key_here

# Optional overrides. Defaults are set in src/fact_checker/config.py.
# LLM_PROVIDER=openrouter
# LLM_MODEL_NAME lets you move off a deprecated model without a code change.
# Defaults: particle-ai/particle-1 (openrouter; use OpenRouter's provider/model slugs,
# e.g. qwen/qwen3.8-27b), gpt-6-luna (openai), qwen-3.8-27b (cerebras).
# LLM_MODEL_NAME=particle-ai/particle-1
# LLM_REQUESTS_PER_MIN=300
# LLM_MAX_COMPLETION_TOKENS=16384
# OPENAI_REASONING_EFFORT=high
# CEREBRAS_REASONING_EFFORT=high
# OPENROUTER_REASONING_EFFORT=high
# OpenRouter only routes to US- and Europe-based backends (see config.py). Comma-separated
# OpenRouter provider slugs here replace that list; check a change with
# scripts/check_openrouter_providers.py.
# OPENROUTER_ALLOWED_PROVIDERS=together,fireworks,deepinfra
